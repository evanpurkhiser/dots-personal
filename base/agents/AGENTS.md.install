#!/usr/bin/env bash

source "$DOTS_SOURCE/base/bash/environment"

declare -A CONFIGS=(
	[claude]=CLAUDE.md
	[codex]=AGENTS.md
	[grok]=AGENTS.md
)

for tool in "${!CONFIGS[@]}"; do
	config_home="$XDG_CONFIG_HOME/$tool"
	target="$config_home/${CONFIGS[$tool]}"

	mkdir -p "$config_home"
	rm -f "$target"
	ln -sf "$XDG_CONFIG_HOME/agents/AGENTS.md" "$target"
done
