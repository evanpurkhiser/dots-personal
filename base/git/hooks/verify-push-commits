#!/bin/sh

set -eu

remote_name=${1-}
verified_commits=$(mktemp "${TMPDIR:-/tmp}/verify-push-signatures.XXXXXX")
trap 'rm -f "$verified_commits"' EXIT HUP INT TERM

author_emails=$(git config --get-all hooks.verify-signatures.authorEmail || true)

if [ -z "$author_emails" ]; then
	echo "pre-push: hooks.verify-signatures.authorEmail is not configured" >&2
	exit 1
fi

is_zero_oid() {
	case "$1" in
	'' | *[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

is_personal_commit() {
	commit=$1
	author_email=$(git show -s --format=%ae "$commit")

	while IFS= read -r expected_email; do
		if [ "$author_email" = "$expected_email" ]; then
			return 0
		fi
	done <<EOF
$author_emails
EOF

	return 1
}

signature_description() {
	case "$1" in
	N) printf 'unsigned' ;;
	B) printf 'bad signature' ;;
	E) printf 'signature could not be checked' ;;
	X) printf 'expired signature' ;;
	Y) printf 'signature made with an expired key' ;;
	R) printf 'signature made with a revoked key' ;;
	U) printf 'signature from an untrusted key' ;;
	G) printf 'good signature' ;;
	*) printf 'unknown signature status' ;;
	esac
}

invalid_commits=0
range_errors=0

verify_commit() {
	commit=$1

	if grep -Fqx "$commit" "$verified_commits"; then
		return
	fi

	printf '%s\n' "$commit" >>"$verified_commits"

	if ! is_personal_commit "$commit"; then
		return
	fi

	if git verify-commit "$commit" >/dev/null 2>&1; then
		return
	fi

	if [ "$invalid_commits" -eq 0 ]; then
		echo "pre-push: refusing to push commits authored by you without a valid signature:" >&2
	fi

	short_oid=$(git rev-parse --short "$commit")
	subject=$(git show -s --format=%s "$commit")
	signature_status=$(git show -s --format=%G? "$commit" 2>/dev/null || printf E)

	printf '  %s %s (%s)\n' \
		"$short_oid" "$subject" \
		"$(signature_description "$signature_status")" >&2
	invalid_commits=$((invalid_commits + 1))
}

verify_range() {
	range_description=$1
	shift

	if ! commits=$(git rev-list "$@"); then
		echo "pre-push: could not inspect commits for $range_description" >&2
		range_errors=$((range_errors + 1))
		return
	fi

	for commit in $commits; do
		verify_commit "$commit"
	done
}

while read -r local_ref local_oid remote_ref remote_oid; do
	if [ -z "${local_ref:-}" ] || is_zero_oid "$local_oid"; then
		continue
	fi

	if ! local_commit=$(git rev-parse --verify "$local_oid^{commit}" 2>/dev/null); then
		# Tags may point to trees or blobs, which introduce no commits.
		continue
	fi

	if is_zero_oid "$remote_oid"; then
		if [ -n "$remote_name" ] && git remote get-url "$remote_name" >/dev/null 2>&1; then
			verify_range "$local_ref -> $remote_ref" \
				"$local_commit" --not "--remotes=$remote_name"
		else
			verify_range "$local_ref -> $remote_ref" "$local_commit"
		fi

		continue
	fi

	if ! remote_commit=$(git rev-parse --verify "$remote_oid^{commit}" 2>/dev/null); then
		echo "pre-push: cannot inspect $remote_ref because $remote_oid is unavailable locally" >&2
		echo "pre-push: fetch $remote_name and try again" >&2
		range_errors=$((range_errors + 1))
		continue
	fi

	verify_range "$local_ref -> $remote_ref" "$remote_commit..$local_commit"
done

if [ "$invalid_commits" -gt 0 ] || [ "$range_errors" -gt 0 ]; then
	exit 1
fi
