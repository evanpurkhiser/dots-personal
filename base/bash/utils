#!/usr/bin/env bash

function progress_timer() {
	local name="$1"
	shift

	# Just eval the command for non-interactive shells
	if [[ $- != *i* ]]; then
		eval "$*"
		return
	fi

	local start=${EPOCHREALTIME/./}
	eval "$*"
	local end=${EPOCHREALTIME/./}

	local evaltime=$(echo | awk "{printf \"%.2f\", ($end - $start) / 1000}")

	echo -e "\e[0;32m ✓\033[0;90m ${name} \e[0;37m${evaltime}ms\e[0m"
}

function cache_cmd() {
	local cmd_full="$*"
	local cmd_short="$(basename "${cmd_full%% *}")"

	# macOS ships `md5`, coreutils ships `md5sum`. The latter also appends the
	# input name to its output, which cut discards to keep hashes identical
	# across platforms.
	local hasher=md5sum
	hash md5 2>/dev/null && hasher=md5

	local checksum=$(echo "${cmd_full}" | "${hasher}" | cut -d' ' -f1)

	local cache_dir="${XDG_CACHE_HOME}/cmd-cache"
	local cached_cmd="${cache_dir}/${cmd_short}.${checksum}"

	[[ ! -d "${cache_dir}" ]] && mkdir -p "${cache_dir}"

	# Only cache successful, non-empty output. Redirecting straight into the
	# cache file would persist a failure forever, since the file existing is
	# what marks the command as cached.
	if [[ ! -f "${cached_cmd}" ]]; then
		local output
		output=$(eval "$cmd_full") || return 1

		[[ -z "${output}" ]] && return 1

		printf '%s\n' "${output}" >"${cached_cmd}"
	fi

	cat "${cached_cmd}"
}

function confirm_prompt() {
	read -r -n 1 -p "$1 [Y/n] " answer
	echo

	case ${answer:0:1} in
	y | Y | "")
		return 0
		;;
	*)
		return 1
		;;
	esac
}
