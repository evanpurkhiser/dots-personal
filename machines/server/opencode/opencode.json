{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "autoupdate": true,
  "server": {
    "port": 4096
  },
  "agent": {
    "build": {
      "permission": {
        "external_directory": {
          "/mnt/documents/obsidian-vault/**": "allow",
          "/home/evan/.local/etc/**": "allow",
          "/home/evan/.config/**": "allow"
        },
        "read": {
          "/mnt/documents/obsidian-vault/**": "allow",
          "/home/evan/.local/etc/**": "allow",
          "/home/evan/.config/**": "allow"
        },
        "edit": {
          "/mnt/documents/obsidian-vault/**": "allow",
          "/home/evan/.local/etc/**": "allow",
          "/home/evan/.config/**": "allow"
        },
        "glob": {
          "/mnt/documents/obsidian-vault/**": "allow",
          "/home/evan/.local/etc/**": "allow",
          "/home/evan/.config/**": "allow"
        },
        "grep": {
          "/mnt/documents/obsidian-vault/**": "allow",
          "/home/evan/.local/etc/**": "allow",
          "/home/evan/.config/**": "allow"
        }
      }
    }
  },
  "mcp": {
    "home-assistant": {
      "type": "remote",
      "url": "http://127.0.0.1:9584/private_zbONmPV3vWR6PgcbZCKUHA"
    },
    "lunchmoney": {
      "type": "local",
      "command": [
        "/home/evan/.config/bash/bin/mcp-sandbox-lunchmoney"
      ]
    },
    "fli": {
      "type": "local",
      "command": [
        "/home/evan/.config/bash/bin/mcp-sandbox-fli"
      ]
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
