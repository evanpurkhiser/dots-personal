def success_page() -> bytes:
    return b"""<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Secret received</title>
<style>
  :root { color-scheme: light dark; font: 18px/1.5 system-ui, sans-serif; }
  body {
    display: grid;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    padding: max(1rem, env(safe-area-inset-top))
      max(1rem, env(safe-area-inset-right))
      max(1rem, env(safe-area-inset-bottom))
      max(1rem, env(safe-area-inset-left));
    place-items: center;
    background: #f3f4f6;
    color: #18181b;
  }
  p {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid #d4d4d8;
    border-radius: 1rem;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 18px 45px rgb(24 24 27 / 10%);
  }
  @media (prefers-color-scheme: dark) {
    body { background: #09090b; color: #fafafa; }
    p { border-color: #3f3f46; background: #18181b; box-shadow: 0 18px 45px rgb(0 0 0 / 35%); }
  }
</style>
<p>Secret received. You can close this page.</p>
</html>"""


def handler_for(token: str, destination: Path, received: threading.Event):
    expected_path = f"/{token}"

    class SecretHandler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            if self.path != expected_path or received.is_set():
                self.send_error(HTTPStatus.NOT_FOUND)
                return

            self.respond(HTTPStatus.OK, form_page())

        def do_POST(self) -> None:
            if self.path != expected_path or received.is_set():
                self.send_error(HTTPStatus.NOT_FOUND)
                return

            content_type = self.headers.get_content_type()
            content_length = self.content_length()
            if content_type != "application/x-www-form-urlencoded":
                self.send_error(HTTPStatus.UNSUPPORTED_MEDIA_TYPE)
                return
            if (
                content_length is None
                or content_length <= 0
                or content_length > MAX_SECRET_BYTES
            ):
                self.send_error(HTTPStatus.REQUEST_ENTITY_TOO_LARGE)
                return

            try:
                form = parse_qs(
                    self.rfile.read(content_length).decode("utf-8"),
                    keep_blank_values=True,
                    strict_parsing=True,
                )
            except (UnicodeDecodeError, ValueError):
                self.send_error(HTTPStatus.BAD_REQUEST, "Invalid form data")
                return
            values = form.get("secret", [])
            if len(values) != 1 or not values[0]:
                self.send_error(HTTPStatus.BAD_REQUEST, "A secret is required")
                return

            try:
                write_secret(destination, values[0])
            except FileExistsError:
                self.send_error(HTTPStatus.CONFLICT, "Output path already exists")
                return

            received.set()
            self.respond(HTTPStatus.OK, success_page())

        def content_length(self) -> int | None:
            raw_length = self.headers.get("Content-Length")
            if raw_length is None:
                return None

            try:
                return int(raw_length)
            except ValueError:
                return None

        def respond(self, status: HTTPStatus, body: bytes) -> None:
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Security-Policy", "default-src 'self' 'unsafe-inline'")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, format: str, *args: object) -> None:
            pass

    return SecretHandler


def main() -> int:
    args = parse_args()
    port = args.port or available_port()
    destination = output_path(args.output)
    token = secrets.token_urlsafe(24)
    received = threading.Event()
    handler = handler_for(token, destination, received)

    try:
        server = HTTPServer(("127.0.0.1", port), handler)
    except OSError as error:
        print(f"secret-receive: could not listen on port {port}: {error}", file=sys.stderr)
        return 1

    server.timeout = 0.5
    print(f"Open https://{port}.prk.network/{token}", flush=True)
    print(f"Waiting up to {args.timeout} seconds for one secret...", flush=True)

    deadline = time.monotonic() + args.timeout
    try:
        while not received.is_set() and time.monotonic() < deadline:
            server.handle_request()
    except KeyboardInterrupt:
        print("\nCanceled; no secret was written.", file=sys.stderr)
        return 130
    finally:
        server.server_close()

    if not received.is_set():
        print("Timed out; no secret was written.", file=sys.stderr)
        return 1

    print(f"Secret written to {destination}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
