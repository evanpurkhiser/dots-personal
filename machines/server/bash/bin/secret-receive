#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///

"""Receive one secret through a short-lived tailnet web page."""

from __future__ import annotations

import argparse
import html
import json
import os
import re
import secrets
import socket
import sys
import tempfile
import threading
import time
from dataclasses import dataclass
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from urllib.parse import parse_qs

DEFAULT_TIMEOUT = 600
MAX_SECRET_BYTES = 1024 * 1024
FIELD_NAME_PATTERN = re.compile(r"[A-Za-z][A-Za-z0-9_-]*")
FIELD_TYPES = {"email", "number", "password", "tel", "text", "textarea", "url"}
INPUT_MODES = {"decimal", "email", "none", "numeric", "search", "tel", "text", "url"}


@dataclass(frozen=True)
class Field:
    name: str
    label: str
    type: str = "text"
    autocomplete: str | None = None
    inputmode: str | None = None
    required: bool = True


PRESETS = {
    "login": (
        Field("username", "Username", autocomplete="username"),
        Field(
            "password",
            "Password",
            type="password",
            autocomplete="current-password",
        ),
    ),
    "login-2fa": (
        Field("username", "Username", autocomplete="username"),
        Field(
            "password",
            "Password",
            type="password",
            autocomplete="current-password",
        ),
        Field(
            "totp",
            "2FA code",
            autocomplete="one-time-code",
            inputmode="numeric",
        ),
    ),
    "credit-card": (
        Field("cardholder", "Name on card", autocomplete="cc-name"),
        Field(
            "card_number",
            "Card number",
            autocomplete="cc-number",
            inputmode="numeric",
        ),
        Field(
            "expiration",
            "Expiration",
            autocomplete="cc-exp",
            inputmode="numeric",
        ),
        Field(
            "security_code",
            "Security code",
            type="password",
            autocomplete="cc-csc",
            inputmode="numeric",
        ),
    ),
}


def parse_field(spec: str) -> Field:
    parts = spec.split(";")
    name = parts[0].strip()
    if not FIELD_NAME_PATTERN.fullmatch(name):
        raise ValueError(
            f"invalid field name {name!r}; use letters, numbers, underscores, or hyphens"
        )

    options: dict[str, str] = {}
    optional = False
    for part in parts[1:]:
        part = part.strip()
        if part == "optional":
            if optional:
                raise ValueError(f"field {name!r} repeats option 'optional'")

            optional = True
            continue

        key, separator, value = part.partition("=")
        key = key.strip()
        value = value.strip()
        if not separator or not key or not value:
            raise ValueError(f"invalid option {part!r} for field {name!r}")
        if key not in {"autocomplete", "inputmode", "label", "type"}:
            raise ValueError(f"unknown option {key!r} for field {name!r}")
        if key in options:
            raise ValueError(f"field {name!r} repeats option {key!r}")

        options[key] = value

    field_type = options.get("type", "text")
    if field_type not in FIELD_TYPES:
        choices = ", ".join(sorted(FIELD_TYPES))
        raise ValueError(f"invalid type {field_type!r} for field {name!r}; choose from {choices}")

    inputmode = options.get("inputmode")
    if inputmode is not None and inputmode not in INPUT_MODES:
        choices = ", ".join(sorted(INPUT_MODES))
        raise ValueError(
            f"invalid inputmode {inputmode!r} for field {name!r}; choose from {choices}"
        )

    label = options.get("label", name.replace("_", " ").replace("-", " ").capitalize())
    return Field(
        name=name,
        label=label,
        type=field_type,
        autocomplete=options.get("autocomplete"),
        inputmode=inputmode,
        required=not optional,
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Receive one secret submission from an HTTPS page on the tailnet, "
            "write it to a mode-0600 file, then exit. Plain submissions are written "
            "as text; presets and custom fields are written as JSON."
        ),
        epilog=(
            "Custom field syntax: name[;label=...][;type=...][;autocomplete=...]"
            "[;inputmode=...][;optional]. The default output file is created under "
            "$XDG_RUNTIME_DIR (or the system temporary directory). Remove it after "
            "use."
        ),
    )
    parser.add_argument(
        "--title",
        default="Send a secret",
        help="page title (default: %(default)s)",
    )
    parser.add_argument(
        "--description",
        help="text shown above the form",
    )
    schema = parser.add_mutually_exclusive_group()
    schema.add_argument(
        "--preset",
        choices=PRESETS,
        help="use a predefined structured form and write its values as JSON",
    )
    schema.add_argument(
        "--field",
        action="append",
        dest="field_specs",
        metavar="SPEC",
        help="add a structured field; repeat for multiple fields",
    )
    parser.add_argument(
        "-p",
        "--port",
        type=int,
        default=0,
        help="local port from 3000 to 19999 (default: choose an available port)",
    )
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        help="output path, which must not already exist (default: secure temp file)",
    )
    parser.add_argument(
        "-t",
        "--timeout",
        type=int,
        default=DEFAULT_TIMEOUT,
        metavar="SECONDS",
        help=f"stop waiting after this many seconds (default: {DEFAULT_TIMEOUT})",
    )
    args = parser.parse_args()

    if args.port and not 3000 <= args.port <= 19999:
        parser.error("--port must be between 3000 and 19999")
    if args.timeout <= 0:
        parser.error("--timeout must be greater than zero")
    if not args.title.strip():
        parser.error("--title must not be empty")

    if args.preset:
        args.fields = PRESETS[args.preset]
    elif args.field_specs:
        try:
            args.fields = tuple(parse_field(spec) for spec in args.field_specs)
        except ValueError as error:
            parser.error(str(error))

        names = [field.name for field in args.fields]
        if len(names) != len(set(names)):
            parser.error("field names must be unique")
    else:
        args.fields = None

    return args


def available_port() -> int:
    for _ in range(100):
        port = secrets.randbelow(17000) + 3000
        with socket.socket() as candidate:
            try:
                candidate.bind(("127.0.0.1", port))
            except OSError:
                continue

        return port

    raise RuntimeError("could not find an available port")


def output_path(requested: Path | None) -> Path:
    if requested is not None:
        return requested.expanduser().resolve()

    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    directory = runtime_dir if runtime_dir else tempfile.gettempdir()
    return Path(directory) / f"secret-receive-{secrets.token_hex(8)}"


def write_secret(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(path, flags, 0o600)

    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as output:
            output.write(value)
    except BaseException:
        path.unlink(missing_ok=True)
        raise


def render_field(field: Field, autofocus: bool = False) -> str:
    attributes = [
        ("id", f"field-{field.name}"),
        ("name", field.name),
    ]
    if field.type != "textarea":
        attributes.append(("type", field.type))
    if field.autocomplete:
        attributes.append(("autocomplete", field.autocomplete))
    if field.inputmode:
        attributes.append(("inputmode", field.inputmode))

    rendered_attributes = "".join(
        f' {name}="{html.escape(value, quote=True)}"' for name, value in attributes
    )
    rendered_attributes += ' spellcheck="false"'
    if autofocus:
        rendered_attributes += " autofocus"
    if field.required:
        rendered_attributes += " required"

    if field.type == "textarea":
        control = f"<textarea{rendered_attributes}></textarea>"
    else:
        control = f"<input{rendered_attributes}>"

    return (
        '<div class="field">'
        f'<label for="field-{html.escape(field.name, quote=True)}">'
        f"{html.escape(field.label)}</label>"
        f"{control}"
        "</div>"
    )


def form_page(
    title: str,
    description: str | None,
    fields: tuple[Field, ...] | None,
) -> bytes:
    if description is None:
        description = (
            "The server accepts one set of values and then shuts down."
            if fields
            else "The server accepts one value and then shuts down."
        )

    if fields:
        controls = "".join(
            render_field(field, autofocus=index == 0)
            for index, field in enumerate(fields)
        )
        paste_button = ""
        script = ""
        form_attributes = ""
    else:
        controls = (
            '<textarea class="secret" name="secret" aria-label="Secret" '
            'autocomplete="off" autofocus required spellcheck="false"></textarea>'
        )
        paste_button = '<button type="button" id="paste">Paste from clipboard</button>'
        script = """
<script>
  const field = document.querySelector('textarea');
  const status = document.querySelector('#status');
  document.querySelector('#paste').addEventListener('click', async () => {
    try {
      field.value = await navigator.clipboard.readText();
      status.textContent = 'Pasted. Review the value, then send it.';
    } catch (error) {
      status.textContent = 'Clipboard access was denied. Paste into the field directly.';
      field.focus();
    }
  });
</script>"""
        form_attributes = ' autocomplete="off"'

    escaped_title = html.escape(title)
    description_markup = (
        f'<p class="description">{html.escape(description)}</p>' if description else ""
    )
    page = """<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>__TITLE__</title>
<style>
  :root {
    color-scheme: light dark;
    font: 17px/1.5 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --background: #f3f4f6;
    --surface: #ffffff;
    --text: #18181b;
    --muted: #52525b;
    --border: #d4d4d8;
    --field: #fafafa;
    --button: #ffffff;
    --button-hover: #f4f4f5;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --primary-text: #ffffff;
    --focus: #2563eb;
    --shadow: 0 18px 45px rgb(24 24 27 / 10%);
  }
  * { box-sizing: border-box; }
  body {
    display: grid;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    padding: max(1rem, env(safe-area-inset-top))
      max(1rem, env(safe-area-inset-right))
      max(1rem, env(safe-area-inset-bottom))
      max(1rem, env(safe-area-inset-left));
    place-items: center;
    background: var(--background);
    color: var(--text);
  }
  main {
    width: min(34rem, 100%);
    padding: clamp(1.25rem, 5vw, 2rem);
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  h1 { margin: 0; font-size: clamp(1.5rem, 6vw, 2rem); line-height: 1.2; }
  .description { margin: .65rem 0 1.25rem; color: var(--muted); }
  .field { margin-top: 1rem; }
  label { display: block; margin-bottom: .35rem; font-weight: 650; }
  input, textarea {
    display: block;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: .7rem;
    padding: .85rem;
    background: var(--field);
    color: var(--text);
    font: inherit;
  }
  textarea { min-height: 8rem; resize: vertical; }
  textarea.secret {
    min-height: clamp(10rem, 34dvh, 18rem);
    font: 16px/1.45 ui-monospace, SFMono-Regular, Consolas, monospace;
  }
  input:focus-visible, textarea:focus-visible, button:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--focus) 35%, transparent);
    outline-offset: 2px;
  }
  .actions { display: flex; gap: .75rem; margin-top: 1rem; }
  button {
    min-height: 3rem;
    flex: 1;
    cursor: pointer;
    border: 1px solid var(--border);
    border-radius: .7rem;
    padding: .7rem 1rem;
    background: var(--button);
    color: var(--text);
    font: inherit;
    font-weight: 650;
    touch-action: manipulation;
  }
  button:hover { background: var(--button-hover); }
  button[type="submit"] {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-text);
  }
  button[type="submit"]:hover { background: var(--primary-hover); }
  #status { min-height: 1.5rem; margin: .75rem 0 0; font-size: .9rem; }
  @media (max-width: 28rem) {
    body { place-items: start center; }
    main { border-radius: .85rem; }
    .actions { flex-direction: column; }
    button { width: 100%; }
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --background: #09090b;
      --surface: #18181b;
      --text: #fafafa;
      --muted: #a1a1aa;
      --border: #3f3f46;
      --field: #09090b;
      --button: #27272a;
      --button-hover: #3f3f46;
      --primary: #3b82f6;
      --primary-hover: #60a5fa;
      --primary-text: #ffffff;
      --focus: #60a5fa;
      --shadow: 0 18px 45px rgb(0 0 0 / 35%);
    }
  }
</style>
"""
    page += f"""<main>
  <h1>{escaped_title}</h1>
  {description_markup}
  <form method="post"{form_attributes}>
    {controls}
    <div class="actions">
      {paste_button}
      <button type="submit">Send secret</button>
    </div>
    <p id="status" role="status" aria-live="polite"></p>
  </form>
</main>
{script}
</html>"""
    return page.replace("__TITLE__", escaped_title).encode()


def success_page() -> bytes:
    return b"""<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Secret received</title>
<style>
  :root { color-scheme: light dark; font: 18px/1.5 system-ui, sans-serif; }
  body {
    display: grid;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    padding: max(1rem, env(safe-area-inset-top))
      max(1rem, env(safe-area-inset-right))
      max(1rem, env(safe-area-inset-bottom))
      max(1rem, env(safe-area-inset-left));
    place-items: center;
    background: #f3f4f6;
    color: #18181b;
  }
  p {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid #d4d4d8;
    border-radius: 1rem;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 18px 45px rgb(24 24 27 / 10%);
  }
  @media (prefers-color-scheme: dark) {
    body { background: #09090b; color: #fafafa; }
    p { border-color: #3f3f46; background: #18181b; box-shadow: 0 18px 45px rgb(0 0 0 / 35%); }
  }
</style>
<p>Secret received. You can close this page.</p>
</html>"""


def submission_value(
    fields: tuple[Field, ...] | None,
    form: dict[str, list[str]],
) -> str:
    if fields is None:
        values = form.get("secret", [])
        if set(form) != {"secret"} or len(values) != 1 or not values[0]:
            raise ValueError("A secret is required")

        return values[0]

    expected_names = {field.name for field in fields}
    if unknown_names := set(form) - expected_names:
        names = ", ".join(sorted(unknown_names))
        raise ValueError(f"Unexpected fields: {names}")

    submission = {}
    for field in fields:
        values = form.get(field.name, [])
        if len(values) > 1:
            raise ValueError(f"{field.label} must have one value")

        value = values[0] if values else ""
        if field.required and not value:
            raise ValueError(f"{field.label} is required")

        submission[field.name] = value

    return json.dumps(submission, ensure_ascii=False, separators=(",", ":"))


def handler_for(
    token: str,
    destination: Path,
    received: threading.Event,
    title: str,
    description: str | None,
    fields: tuple[Field, ...] | None,
):
    expected_path = f"/{token}"

    class SecretHandler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            if self.path != expected_path or received.is_set():
                self.send_error(HTTPStatus.NOT_FOUND)
                return

            self.respond(HTTPStatus.OK, form_page(title, description, fields))

        def do_POST(self) -> None:
            if self.path != expected_path or received.is_set():
                self.send_error(HTTPStatus.NOT_FOUND)
                return

            content_type = self.headers.get_content_type()
            content_length = self.content_length()
            if content_type != "application/x-www-form-urlencoded":
                self.send_error(HTTPStatus.UNSUPPORTED_MEDIA_TYPE)
                return
            if (
                content_length is None
                or content_length <= 0
                or content_length > MAX_SECRET_BYTES
            ):
                self.send_error(HTTPStatus.REQUEST_ENTITY_TOO_LARGE)
                return

            try:
                form = parse_qs(
                    self.rfile.read(content_length).decode("utf-8"),
                    keep_blank_values=True,
                    strict_parsing=True,
                )
            except (UnicodeDecodeError, ValueError):
                self.send_error(HTTPStatus.BAD_REQUEST, "Invalid form data")
                return
            try:
                value = submission_value(fields, form)
            except ValueError as error:
                self.send_error(HTTPStatus.BAD_REQUEST, str(error))
                return

            try:
                write_secret(destination, value)
            except FileExistsError:
                self.send_error(HTTPStatus.CONFLICT, "Output path already exists")
                return

            received.set()
            self.respond(HTTPStatus.OK, success_page())

        def content_length(self) -> int | None:
            raw_length = self.headers.get("Content-Length")
            if raw_length is None:
                return None

            try:
                return int(raw_length)
            except ValueError:
                return None

        def respond(self, status: HTTPStatus, body: bytes) -> None:
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Security-Policy", "default-src 'self' 'unsafe-inline'")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, format: str, *args: object) -> None:
            pass

    return SecretHandler


def main() -> int:
    args = parse_args()
    port = args.port or available_port()
    destination = output_path(args.output)
    token = secrets.token_urlsafe(24)
    received = threading.Event()
    handler = handler_for(
        token,
        destination,
        received,
        args.title,
        args.description,
        args.fields,
    )

    try:
        server = HTTPServer(("127.0.0.1", port), handler)
    except OSError as error:
        print(f"secret-receive: could not listen on port {port}: {error}", file=sys.stderr)
        return 1

    server.timeout = 0.5
    print(f"Open https://{port}.prk.network/{token}", flush=True)
    print(f"Waiting up to {args.timeout} seconds for one submission...", flush=True)

    deadline = time.monotonic() + args.timeout
    try:
        while not received.is_set() and time.monotonic() < deadline:
            server.handle_request()
    except KeyboardInterrupt:
        print("\nCanceled; no secret was written.", file=sys.stderr)
        return 130
    finally:
        server.server_close()

    if not received.is_set():
        print("Timed out; no secret was written.", file=sys.stderr)
        return 1

    print(f"Secret written to {destination}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
