  document.querySelector('#paste').addEventListener('click', async () => {
    try {
      field.value = await navigator.clipboard.readText();
      status.textContent = 'Pasted. Review the value, then send it.';
    } catch (error) {
      status.textContent = 'Clipboard access was denied. Paste into the field directly.';
      field.focus();
    }
