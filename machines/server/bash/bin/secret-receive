#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///

"""Receive one secret through a short-lived tailnet web page."""

from __future__ import annotations

import argparse
import os
import secrets
import socket
import sys
import tempfile
import threading
import time
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from urllib.parse import parse_qs

DEFAULT_TIMEOUT = 600
MAX_SECRET_BYTES = 1024 * 1024


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Receive one secret from an HTTPS page on the tailnet, write it to a "
            "mode-0600 file, then exit. The secret is never written to stdout."
        ),
        epilog=(
            "Open the printed https://<port>.prk.network URL, paste or type the "
            "secret, and submit it. The default output file is created under "
            "$XDG_RUNTIME_DIR (or the system temporary directory). Remove it "
            "after use."
        ),
    )
    parser.add_argument(
        "-p",
        "--port",
        type=int,
        default=0,
        help="local port from 3000 to 19999 (default: choose an available port)",
    )
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        help="output path, which must not already exist (default: secure temp file)",
    )
    parser.add_argument(
        "-t",
        "--timeout",
        type=int,
        default=DEFAULT_TIMEOUT,
        metavar="SECONDS",
        help=f"stop waiting after this many seconds (default: {DEFAULT_TIMEOUT})",
    )
    args = parser.parse_args()

    if args.port and not 3000 <= args.port <= 19999:
        parser.error("--port must be between 3000 and 19999")
    if args.timeout <= 0:
        parser.error("--timeout must be greater than zero")

    return args


def available_port() -> int:
    for _ in range(100):
        port = secrets.randbelow(17000) + 3000
        with socket.socket() as candidate:
            try:
                candidate.bind(("127.0.0.1", port))
            except OSError:
                continue

        return port

    raise RuntimeError("could not find an available port")


def output_path(requested: Path | None) -> Path:
    if requested is not None:
        return requested.expanduser().resolve()

    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    directory = runtime_dir if runtime_dir else tempfile.gettempdir()
    return Path(directory) / f"secret-receive-{secrets.token_hex(8)}"


def write_secret(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(path, flags, 0o600)

    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as output:
            output.write(value)
    except BaseException:
        path.unlink(missing_ok=True)
        raise


def form_page() -> bytes:
    return b"""<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Send a secret</title>
<style>
  :root {
    color-scheme: light dark;
    font: 17px/1.5 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --background: #f3f4f6;
    --surface: #ffffff;
    --text: #18181b;
    --muted: #52525b;
    --border: #d4d4d8;
    --field: #fafafa;
    --button: #ffffff;
    --button-hover: #f4f4f5;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --primary-text: #ffffff;
    --focus: #2563eb;
    --shadow: 0 18px 45px rgb(24 24 27 / 10%);
  }
  * { box-sizing: border-box; }
  body {
    display: grid;
    min-height: 100vh;
    min-height: 100dvh;
