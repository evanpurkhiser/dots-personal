    box-shadow: var(--shadow);
  }
  h1 { margin: 0; font-size: clamp(1.5rem, 6vw, 2rem); line-height: 1.2; }
  p { margin: .65rem 0 1.25rem; color: var(--muted); }
  textarea {
    display: block;
    width: 100%;
    min-height: clamp(10rem, 34dvh, 18rem);
    resize: vertical;
    border: 1px solid var(--border);
    border-radius: .7rem;
    padding: .85rem;
    background: var(--field);
    color: var(--text);
    font: 16px/1.45 ui-monospace, SFMono-Regular, Consolas, monospace;
  }
  textarea:focus-visible, button:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--focus) 35%, transparent);
