#!/bin/bash
# Sandboxed wrapper for lunchmoney MCP server using bubblewrap
#
# This script isolates the lunchmoney-mcp server with restricted filesystem access:
# - Read-only access to system binaries and libraries
# - Read-write access only to npm cache
# - No access to user home directory, /mnt/documents, or /var
# - Minimal /dev access (null, random, urandom only)
# - Network namespace isolated (only WAN interface accessible)
# - Isolated PID, IPC, and UTS namespaces

set -euo pipefail

env_file="${XDG_CONFIG_HOME:-$HOME/.config}/agents/mcp.env"
token_var="${1:-LUNCHMONEY_API_TOKEN}"
lunchmoney_api_token="${!token_var:-}"

if [[ -f "$env_file" ]]; then
	lunchmoney_api_token="$(
		source "$env_file"
		printf %s "${!token_var:-}"
	)"
fi

if [[ -z "$lunchmoney_api_token" ]]; then
	printf 'Missing Lunch Money token: %s\n' "$token_var" >&2
	exit 1
fi

# Bubblewrap's parent-death signal follows the launching thread. Keep this shell
# alive as its parent when the MCP client uses short-lived worker threads.
trap 'exit 143' TERM
trap 'exit 130' INT

bwrap \
	--ro-bind /usr /usr \
	--ro-bind /lib /lib \
	--ro-bind /lib64 /lib64 \
	--symlink usr/bin /bin \
	--ro-bind /etc /etc \
	--tmpfs /tmp \
	--tmpfs /home \
	--dir /home/evan/.cache/npm \
	--bind /home/evan/.cache/npm /home/evan/.cache/npm \
	--proc /proc \
	--dev-bind /dev/null /dev/null \
	--dev-bind /dev/random /dev/random \
	--dev-bind /dev/urandom /dev/urandom \
	--unshare-pid \
	--unshare-ipc \
	--unshare-uts \
	--unshare-net \
	--share-net \
	--die-with-parent \
	--clearenv \
	--setenv PATH "/usr/bin:/bin" \
	--setenv HOME "/home/evan" \
	--setenv LUNCHMONEY_API_TOKEN "$lunchmoney_api_token" \
	npx -y @akutishevsky/lunchmoney-mcp
