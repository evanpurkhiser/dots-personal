#!/usr/bin/env bash

export EVANS_WORKSPACE="$HOME/Coding"

# Include gnu coreutils override bin
export PATH="$HOME/.local/lib/gnu-override/bin:$PATH"

# Avoid brew trying to update during install
export HOMEBREW_NO_AUTO_UPDATE=1

# Do not do cleanup after installs, we'll manually run this
export HOMEBREW_NO_INSTALL_CLEANUP=1

# Keep Terminal.app from creating ~/.bash_sessions. Marking init as already
# done is the only opt-out that isn't itself a file in $HOME (the documented
# alternative is touching ~/.bash_sessions_disable).
export SHELL_SESSION_DID_INIT=1

# Photoshop MCP server keeps its config, sqlite db, and image exports here
export PHOTOSHOP_MCP_HOME="$XDG_DATA_HOME/photoshop-mcp"

# Use 1Password's SSH agent. ssh/config already points IdentityAgent here, but
# that is an ssh_config directive -- `ssh-keygen -Y sign`, which git uses to
# sign commits, does not read ssh_config and only consults $SSH_AUTH_SOCK.
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
