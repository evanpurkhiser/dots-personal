#!/usr/bin/env bash

source "$DOTS_SOURCE"/base/bash/environment

PLIST_NAME="local.pr-statusline.plist"
DEST_PLIST="$HOME/Library/LaunchAgents/$PLIST_NAME"
DOMAIN="gui/$(id -u)"
SERVICE="$DOMAIN/${PLIST_NAME%.plist}"

mkdir -p "$(dirname "$DEST_PLIST")" || exit
cp "$XDG_CONFIG_HOME"/LaunchAgents/"$PLIST_NAME" "$DEST_PLIST" || exit

if launchctl print "$SERVICE" >/dev/null 2>&1; then
	launchctl bootout "$SERVICE" || exit
fi

launchctl bootstrap "$DOMAIN" "$DEST_PLIST"
